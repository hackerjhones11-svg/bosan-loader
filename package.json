{
  "name": "langur-burja",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A fair, tactile Langur Burja / Jhandi Burja six-dice simulator.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "diag:distribution": "vitest run --config vitest.diag.config.ts scripts/distribution.diag.ts",
    "diag:simulation": "vitest run --config vitest.diag.config.ts scripts/simulation.diag.ts"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.2",
    "cannon-es": "^0.20.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
